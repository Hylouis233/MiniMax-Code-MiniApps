{
  "schemaVersion": 1,
  "artifacts": {
    "client": ["./miniapp/client"],
    "node": ["./miniapp/node"]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/watchdog",
    "window": {
      "width": 900,
      "height": 640,
      "minWidth": 640,
      "minHeight": 420
    }
  },
  "mcpEndpoints": [],
  "agentAccess": ["session.run"],
  "agentConcurrency": 2
}
